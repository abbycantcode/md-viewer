[Desktop Entry]
Type=Application
Name=Markdown Viewer
GenericName=Markdown Studio & Viewer
Comment=Native Markdown studio with live watch mode, diff review, KaTeX, and Mermaid
Exec=md-viewer %F
TryExec=md-viewer
Icon=text-x-markdown
Terminal=false
Categories=Utility;TextEditor;Office;Viewer;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
Keywords=markdown;md;viewer;editor;agent;watch;diff;katex;mermaid;
